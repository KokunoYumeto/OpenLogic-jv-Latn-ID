{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLSIZ-20260904", "finding_id": "OLSIZ-001", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0029", "path": "content/sets-functions-relations/size-of-sets/enumerability.tex", "bytes": 12006, "sha256": "bf6be35c0e393cb6e1d227f8e9024df4216792e663f23beb7277045487acfa67", "locator": "lines 145-153", "finding": "The header and formula rows include f(7), whose value is -3, but the final value row stops at 3 and omits -3.", "controlling_evidence": "At f(7), the preceding formula row is -ceil(6/2), hence -3.", "mathematical_delta": {"display_value_added": "-3"}}, "target": {"path": "translation/content/sets-functions-relations/size-of-sets/enumerability.tex", "bytes": 12435, "sha256": "8072a19e227b50388b976d5adae4bab74948eabf8604755805d3531a341a0ab0", "adjacent_note_lines": [155], "adjacent_contexts": [{"line_start": 153, "line_end": 156, "sha256_utf8_lf": "f70e91e3566d72e852a3b643e264d84ad87458ce0b7ac3df4fa136a2d8b92e75"}], "applied_handling": "Added -3 beneath f(7) in the final value row."}, "audit_artifacts": {"findings_file": "FINDINGS.json", "findings_sha256": "9b6e836c8432eb75d331913983603796d6557da6ec3ad71b846b2a248374cd07", "review_file": "REVIEW.md", "review_sha256": "26913176baacbda5ae8a47bcc82ccf0366b0763313e6eeeb45df59e64249a1f9"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "7790323d5695b5174a0f7db9581e383913396ede609245b76955e884e304bfce", "structural_status": "structural_pass", "semantic_review_sha256": "120360354305a4ab517c93ef024aa4adff9c14e171f1d6dc749cb3d5066098fe", "semantic_review_status": "pass"}}
{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLSIZ-20260904", "finding_id": "OLSIZ-002", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0031", "path": "content/sets-functions-relations/size-of-sets/pairing.tex", "bytes": 4056, "sha256": "fb6cc1176e91e56cea5f5b9708723c59191813f8fe256aac8ed0457a0119a9bf", "locator": "lines 91-96", "finding": "The phrase 'complement of a finite set Nat' is malformed and omits the relation between the finite set and Nat.", "controlling_evidence": "The following equivalence says A is cofinite iff Nat\\setminus A is finite.", "mathematical_delta": null}, "target": {"path": "translation/content/sets-functions-relations/size-of-sets/pairing.tex", "bytes": 4165, "sha256": "b766c4a116aba8a91e807ea82a9078112fa9cd0196247fa4af114ae689f61804", "adjacent_note_lines": [97], "adjacent_contexts": [{"line_start": 95, "line_end": 98, "sha256_utf8_lf": "f5665934d8ca235588acd89ca6c2e815ba3c5266b98c174cbe7e3805c120c3de"}], "applied_handling": "Stated the complement in Nat of a finite subset there."}, "audit_artifacts": {"findings_file": "FINDINGS.json", "findings_sha256": "9b6e836c8432eb75d331913983603796d6557da6ec3ad71b846b2a248374cd07", "review_file": "REVIEW.md", "review_sha256": "26913176baacbda5ae8a47bcc82ccf0366b0763313e6eeeb45df59e64249a1f9"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "7790323d5695b5174a0f7db9581e383913396ede609245b76955e884e304bfce", "structural_status": "structural_pass", "semantic_review_sha256": "120360354305a4ab517c93ef024aa4adff9c14e171f1d6dc749cb3d5066098fe", "semantic_review_status": "pass"}}
