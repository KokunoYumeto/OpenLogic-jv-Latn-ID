{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLPL-20260905", "finding_id": "OLPL-001", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0058", "path": "content/propositional-logic/syntax-and-semantics/formulas.tex", "bytes": 7021, "sha256": "f05ab9c5e23b362dbee9f6063f096f52ebc9e7f97b29acc9c07f18788f1f8f48", "locator": "line 159", "finding": "The material-conditional abbreviation closes an outer parenthesis which it never opens.", "controlling_evidence": "The same file's binary-connective formation clauses enclose compound formulas in a matched outer parenthesis pair. The branch is intended to abbreviate the disjunction of not-A with B, and the unmatched delimiter is a presentation error rather than an alternate logical definition.", "mathematical_delta": {"removed": "$\\lnot !A \\lor !B)$", "added": "$(\\lnot !A \\lor !B)$"}}, "target": {"path": "translation/content/propositional-logic/syntax-and-semantics/formulas.tex", "bytes": 7311, "sha256": "4970549092af228a0eaab6c3b16092aaaa67f3de2c7e39c1ed6d8df1eb587c11", "adjacent_note_lines": [161], "adjacent_contexts": [{"line_start": 159, "line_end": 162, "sha256_utf8_lf": "f7ed89dfd121e5495df42c468e35d6b2ce9b48da4a47695759e16497706ab0b7"}], "applied_handling": "Restored the missing opening parenthesis in the material-conditional abbreviation."}, "audit_artifacts": {"review_file": "OLPL001_SOURCE_AUDIT.json", "review_sha256": "1d959ac9106318cc04e7fcace58d3c339aebf975eeee7d32419d198d4a04e16f"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "05d2bbf0c18ae77157a8bb2a0cafef0e10d1841adbad1eaa8878d4f7a73ec006", "structural_status": "structural_pass", "semantic_review_sha256": "03e91c3b1b5f30b2670a27a14ee56599f5a565408a788c49e2edde48722f3480", "semantic_review_status": "pass"}}
{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLPL-TABLEAU-20260905", "finding_id": "OLPL-002", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0067", "path": "content/first-order-logic/proof-systems/tableaux.tex", "bytes": 3914, "sha256": "8c9db50bcbc7a4aa757b8d57796b2e51df04b1cabb61f46756a79f72a1780b8f", "locator": "line 38", "finding": "The false-conjunction rule name receives the entire formula as its connective argument.", "controlling_evidence": "The immediately preceding true-conjunction rule is named with the conjunction connective alone. Every other false-conjunction rule name in the frozen corpus found by exact search uses \\TRule{\\False}{\\land}.", "mathematical_delta": {"removed": "\\TRule{\\False}{!A \\land !B}", "added": "\\TRule{\\False}{\\land}"}}, "target": {"path": "translation/content/first-order-logic/proof-systems/tableaux.tex", "bytes": 4342, "sha256": "fee2c7294897cbcfaf087985b9c265c17872b02a6ff37f791347c3ee2f9d0b5d", "adjacent_note_lines": [41], "adjacent_contexts": [{"line_start": 39, "line_end": 43, "sha256_utf8_lf": "5521ad976641263f55519e3253032d75f58d669b7bc7c870fac94ffc16601088"}], "applied_handling": "Replaced the full-formula rule-name argument by the conjunction connective."}, "audit_artifacts": {"review_file": "OLPL_TABLEAU_SOURCE_AUDIT.json", "review_sha256": "f279183c761edada863c7ad07fba4a8f23d472852c5b9fe1c1a394696d491761"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "05d2bbf0c18ae77157a8bb2a0cafef0e10d1841adbad1eaa8878d4f7a73ec006", "structural_status": "structural_pass", "semantic_review_sha256": "03e91c3b1b5f30b2670a27a14ee56599f5a565408a788c49e2edde48722f3480", "semantic_review_status": "pass"}}
{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLPL-TABLEAU-20260905", "finding_id": "OLPL-003", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0067", "path": "content/first-order-logic/proof-systems/tableaux.tex", "bytes": 3914, "sha256": "8c9db50bcbc7a4aa757b8d57796b2e51df04b1cabb61f46756a79f72a1780b8f", "locator": "lines 57-58", "finding": "The example labels both children of a true conjunction as true-implication expansions.", "controlling_evidence": "The parent on line 2 of the displayed tableau is the signed formula true (A and B). Its two children are true A and true B, exactly the outputs of the true-conjunction rule described in the preceding paragraph.", "mathematical_delta": {"removed": "\\TRule{\\True}{\\lif}[2]", "added": "\\TRule{\\True}{\\land}[2]"}}, "target": {"path": "translation/content/first-order-logic/proof-systems/tableaux.tex", "bytes": 4342, "sha256": "fee2c7294897cbcfaf087985b9c265c17872b02a6ff37f791347c3ee2f9d0b5d", "adjacent_note_lines": [68], "adjacent_contexts": [{"line_start": 66, "line_end": 70, "sha256_utf8_lf": "de8193217b2cbb4c1945395bf9ae9e3960653556f3a01b62f9809096c481b57b"}], "applied_handling": "Relabeled both true-conjunction expansions with the true-conjunction rule."}, "audit_artifacts": {"review_file": "OLPL_TABLEAU_SOURCE_AUDIT.json", "review_sha256": "f279183c761edada863c7ad07fba4a8f23d472852c5b9fe1c1a394696d491761"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "05d2bbf0c18ae77157a8bb2a0cafef0e10d1841adbad1eaa8878d4f7a73ec006", "structural_status": "structural_pass", "semantic_review_sha256": "03e91c3b1b5f30b2670a27a14ee56599f5a565408a788c49e2edde48722f3480", "semantic_review_status": "pass"}}
