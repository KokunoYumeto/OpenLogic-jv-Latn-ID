{"schema": "jv-source-correction/1", "record_type": "source_correction", "audit_id": "OLSIZ-20260904", "finding_id": "OLSIZ-008", "status": "applied_and_verified", "source": {"revision": "9620cc73f9c8e0ad003c514a5d3748f29611c4c0", "unit_id": "OLP-0039", "path": "content/sets-functions-relations/size-of-sets/non-enumerability-alt.tex", "bytes": 6574, "sha256": "a075f6c63879101314fb20fa493acfb38d78ff24095bb55914f2af4527e1ad3e", "locator": "lines 61-75", "finding": "The prose calls s_n(m) the nth digit of the mth string, reversing the indices.", "controlling_evidence": "The next sentence and array place s_n(m) in row n and column m, so it is the mth digit of the nth string.", "mathematical_delta": null}, "target": {"path": "translation/content/sets-functions-relations/size-of-sets/non-enumerability-alt.tex", "bytes": 6958, "sha256": "5af7c817395540e2fc9137f8960a116d4822026b391797d65c80c974ef9967c1", "adjacent_note_lines": [68], "adjacent_contexts": [{"line_start": 66, "line_end": 69, "sha256_utf8_lf": "446a1a7812d704a002442d0ac1c2d87f0814e885b3b3aeac438322359388d211"}], "applied_handling": "Described s_n(m) as the mth digit of the nth string."}, "audit_artifacts": {"findings_file": "FINDINGS.json", "findings_sha256": "9b6e836c8432eb75d331913983603796d6557da6ec3ad71b846b2a248374cd07", "review_file": "REVIEW.md", "review_sha256": "26913176baacbda5ae8a47bcc82ccf0366b0763313e6eeeb45df59e64249a1f9"}, "verification": {"frozen_source_hash_matches_manifest": true, "frozen_source_unmodified": true, "batch_qa_sha256": "05d2bbf0c18ae77157a8bb2a0cafef0e10d1841adbad1eaa8878d4f7a73ec006", "structural_status": "structural_pass", "semantic_review_sha256": "03e91c3b1b5f30b2670a27a14ee56599f5a565408a788c49e2edde48722f3480", "semantic_review_status": "pass"}}
