    \IfBooleanTF{#1}{%
      \IfBooleanTF{#2}{\Article{#3}~\IfBooleanTF{#4}{\printtoken{p}{#3}}{\printtoken{s}{#3}}}{\IfBooleanTF{#4}{\printtoken{P}{#3}}{\printtoken{S}{#3}}}%
    }{%
      \IfBooleanTF{#2}{\article{#3}~}{}%
      \IfBooleanTF{#4}{\printtoken{p}{#3}}{\printtoken{s}{#3}}%
    }%
  }%
}
