% Shared proof chapters appear once under fol. Preserve PL reference access.
\makeatletter
\newif\ifJvSharedChapter
\newcommand{\JvReferenceAliases}{}
\newcommand{\JvAssignReferenceAlias}[2]{%
  \ifcsname r@#2\endcsname
    \global\expandafter\let\csname r@#1\expandafter\endcsname\csname r@#2\endcsname
  \fi
  \ifcsname r@#2@cref\endcsname
    \global\expandafter\let\csname r@#1@cref\expandafter\endcsname\csname r@#2@cref\endcsname
  \fi
}
\newcommand{\JvWriteReferenceAlias}[2]{%
  \immediate\write\@auxout{\string\JvAssignReferenceAlias{#1}{#2}}%
}
\newcommand{\JvTestSharedChapter}[1]{%
  \JvSharedChapterfalse
  \def\do##1{\ifstrequal{#1}{##1}{\JvSharedChaptertrue}{}}%
  \docsvlist{prf,seq,ntd,tab,axd,com}%
}
\let\JvOriginalOlLabel\ollabel
\renewcommand{\ollabel}[1]{%
  \JvOriginalOlLabel{#1}%
  \ifdefstring{\theolpart}{fol}{%
    \edef\JvChapterName{\theolchapter}%
    \expandafter\JvTestSharedChapter\expandafter{\JvChapterName}%
    \ifJvSharedChapter
      \edef\JvAliasName{pl:\theolchapter:\theolsection:#1}%
      \ifcsname JvSeenAlias@\JvAliasName\endcsname\else
        \global\expandafter\let\csname JvSeenAlias@\JvAliasName\endcsname\@empty
        \xappto\JvReferenceAliases{\noexpand\JvWriteReferenceAlias{\JvAliasName}{fol:\theolchapter:\theolsection:#1}}%
      \fi
    \fi
  }{}%
}
% Copy completed references in the next aux read, not a second amsmath label.
\AtEndDocument{%
  \JvReferenceAliases
  \def\do#1{\JvWriteReferenceAlias{pl:#1::chap}{fol:#1::chap}}%
  \docsvlist{prf,seq,ntd,tab,axd,com}%
}
\makeatother

